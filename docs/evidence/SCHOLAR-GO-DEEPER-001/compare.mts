// SCHOLAR-GO-DEEPER-001: Teach me and Go Deeper for one lesson, side by side, measured. Reads the counted test's results (no model call).
import fs from "node:fs";
import { pathToFileURL } from "node:url";
const REPO = "C:/Users/elish/Documents/Competen/competen-godeeper";
const SP = "C:/Users/elish/AppData/Local/Temp/claude/e7cc951866a58dfc/0feb3955-b31d-49b3-9950-3adb8bb92e86/scratchpad";
const OUT = REPO + "/docs/evidence/SCHOLAR-GO-DEEPER-001";
const f = await import(pathToFileURL(REPO + "/src/lib/individual/scholar/deeper-format.ts").href);
const p = await import(pathToFileURL(REPO + "/src/lib/individual/scholar/deeper-prompt.ts").href);
const r = JSON.parse(fs.readFileSync(SP + "/go-deeper-results.json", "utf8"));
const ledger = JSON.parse(fs.readFileSync(SP + "/go-deeper-ledger.json", "utf8"));
const words = (s: string) => new Set((s.toLowerCase().replace(/\[[SRE]\d+\]/g, " ").match(/[a-z][a-z'-]{3,}/g) ?? []));
const sim = (a: string, b: string) => { const x = words(a), y = words(b); const i = [...x].filter(w => y.has(w)).length; return i / Math.max(1, Math.min(x.size, y.size)); };
const teach = r.teach.saved as string;
const teachSentences = p.sentencesOf(teach);
const repeated = (text: string) => { const s = p.sentencesOf(text).filter((x: string) => words(x).size >= 5); const rep = s.filter((x: string) => teachSentences.some((t: string) => sim(x, t) >= 0.7)); return { sentences: s.length, repeated: rep.length, examples: rep.slice(0, 3) }; };
const rows: string[] = [];
const block: string[] = ["# Teach Me and Go Deeper, side by side", "", "Growth and Development, lesson 3 of the fixture's session (slides 23 to 38), staging. Both generated by the real code in the counted test, and not edited. A sentence counts as repeated when at least 70% of its content words appear in one sentence of Teach Me.", ""];
for (const k of ["v2", "understand", "explore", "advanced", "explore2"]) {
  const x = r[k]; if (!x) continue;
  if (!x.saved) { rows.push(`| ${k} | withheld (${x.check?.reason}) | | | | | | ${x.calls} | ${Number(x.cost_usd).toFixed(4)} |`); continue; }
  const d = f.parseDeeperAnswer(x.saved);
  const rep = repeated(d ? f.deeperPlainText(d) : x.saved);
  const scholar = d ? d.sections.filter((s: any) => s.source === "scholar").length : 0;
  rows.push(`| ${k} | ${x.words} | ${d ? d.sections.length : "lesson parts"} | ${scholar} | ${rep.repeated} of ${rep.sentences} | ${d ? d.sections.some((s: any) => s.kind === "misconception") ? "yes" : "no" : "no"} | ${d ? d.sections.some((s: any) => s.kind === "limits") ? "yes" : "no" : "no"} | ${x.calls} | ${Number(x.cost_usd).toFixed(4)} |`);
}
block.push("| Run | Words | Sections | Scholar sections | Sentences repeating Teach Me | Misconception | Limits | Model calls | USD |", "|---|---|---|---|---|---|---|---|---|", ...rows, "", `Teach me itself: ${r.teach.words} words, ${r.teach.calls} call, USD ${Number(r.teach.cost_usd).toFixed(4)}. Ledger for the whole test: ${ledger.calls} calls, USD ${ledger.usd} (cap 24 calls, USD 2.50). \`explore2\` is a second round on top of \`explore\`.`, "");
block.push("## Teach Me", "", "\`\`\`text", teach, "\`\`\`", "");
for (const [k, title] of [["explore", "Go Deeper, Explore"], ["understand", "Go Deeper, Understand"], ["advanced", "Go Deeper, Advanced (the head-control question)"], ["explore2", "Go Deeper, a second Explore round on top of the first"], ["research", "Go Deeper with research, using a labelled test stand-in, not a real paper"], ["v2", "Go Deeper as it was (v2), for comparison"]] as const) {
  const x = r[k]; if (!x) continue;
  block.push(`## ${title}`, "", "\`\`\`text", x.saved ?? `(withheld: ${x.check?.reason}. The model's reply is not shown to a learner.)`, ...(x.research?.ok ? ["", "FROM RESEARCH:", x.research.text] : []), "\`\`\`", "");
}
fs.writeFileSync(OUT + "/side-by-side.md", block.join("\n"));
console.log(rows.join("\n"));
