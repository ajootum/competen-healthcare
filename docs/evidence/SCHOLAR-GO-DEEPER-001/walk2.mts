// SCHOLAR-GO-DEEPER-001: the second, read-only pass of the walk: no model call. Keeps one real generated round (from the counted test, about motor development, citing the slides with pictures)
// on the fixture learner, so pictures, every width and the kept check can be seen on the head-control example.
import { chromium } from "@playwright/test";
import { createRequire } from "node:module";
import { readFileSync, writeFileSync, appendFileSync } from "node:fs";
import { join } from "node:path";
import { pathToFileURL } from "node:url";
const BASE = "http://127.0.0.1:3207", SESSION = "3484e65a-ee9c-425a-9b63-b2cca40c898e";
const OUT = join(process.cwd(), "docs/evidence/SCHOLAR-GO-DEEPER-001");
const SP = "C:/Users/elish/AppData/Local/Temp/claude/e7cc951866a58dfc/0feb3955-b31d-49b3-9950-3adb8bb92e86/scratchpad";
const fixture = readFileSync(process.env.WALK_FIXTURE!, "utf8");
const field = (k: string) => fixture.split(/\r?\n/).find(l => l.startsWith(`${k}=`))?.slice(k.length + 1).trim() ?? "";
const lines: string[] = [];
const say = (l: string) => { lines.push(l); console.log(l); };
const ok = (c: boolean, what: string) => say(`${c ? "PASS" : "FAIL"} ${what}`);
const req = createRequire(join(process.cwd(), "package.json"));
req("@next/env").loadEnvConfig("C:/Users/elish/Documents/Competen/competen-sale-r1");
const url = process.env.STAGING_SUPABASE_URL!;
if (!url.includes("ezhvpgtcqcdsgylrxgdb")) throw new Error("not staging");
process.env.NEXT_PUBLIC_SUPABASE_URL = url; process.env.SUPABASE_SERVICE_ROLE_KEY = process.env.STAGING_SERVICE_ROLE_KEY!;
const admin = req("@supabase/supabase-js").createClient(url, process.env.STAGING_SERVICE_ROLE_KEY!, { auth: { persistSession: false } });
const { data: { users } } = await admin.auth.admin.listUsers({ perPage: 1000 });
const userId = users.find((u: { email?: string }) => u.email === field("email"))?.id;
const store = await import(pathToFileURL(join(process.cwd(), "src/lib/individual/scholar/store.ts")).href);
const sess = await store.getLearningSession(admin, userId, SESSION);
const here = sess.data.steps.find((x: { step: number }) => x.step === 2);
const ids = here.sections.map((x: { chunkId: string }) => x.chunkId);
const round = JSON.parse(readFileSync(`${SP}/picture-round.json`, "utf8")) as { saved: string; model: string; promptVersion: string };
const saved = await store.saveArtefact(admin, userId, { materialId: here.sections[0].materialId, action: "deeper", depth: "brief", content: round.saved, background: null, flags: [], refs: [], dedupeKey: req("node:crypto").createHash("sha256").update("go-deeper-001-walk-pictures-fixture").digest("hex"), model: round.model, promptVersion: round.promptVersion, chunkIds: ids, lesson: { sessionId: SESSION, step: 2 } });
say(`NOTE a real generated round kept on the fixture for this pass: ${saved}`);
const setPolicy = async (value: "on" | "off") => { const { error } = await admin.from("workspace_config_overrides").upsert({ scope_type: "platform", scope_ref: "individual", config_path: "individual.policy.scholar_go_deeper_structured", published: { value }, updated_at: new Date().toISOString() }, { onConflict: "scope_type,scope_ref,config_path" }); if (error) throw new Error(error.message); };
await setPolicy("on");
const since = new Date().toISOString();
const b = await chromium.launch();
const ctx = await b.newContext({ viewport: { width: 1440, height: 900 } });
const page = await ctx.newPage();
await page.goto(`${BASE}/login`, { waitUntil: "networkidle", timeout: 300000 });
await page.waitForTimeout(3000);
await page.getByRole("textbox", { name: /email/i }).fill(field("email"));
await page.locator("input#password").fill(field("password"));
await page.getByRole("button", { name: /sign in/i }).click();
const until = async (t: () => Promise<boolean>, ms = 300000) => { const end = Date.now() + ms; while (Date.now() < end) { if (await t().catch(() => false)) return; await new Promise(r => setTimeout(r, 500)); } throw new Error("timed out"); };
await until(async () => !new URL(page.url()).pathname.startsWith("/login"));
await page.goto(`${BASE}/individual/scholar/study/learn?session=${SESSION}`, { waitUntil: "domcontentloaded", timeout: 300000 });
await until(async () => (await page.locator('[data-testid="go-deeper-round"]').count()) >= 3);
await page.waitForTimeout(3000);
const rounds = page.locator('[data-testid="go-deeper-round"]');
const motor = page.locator('[data-testid="go-deeper-round"]', { hasText: "Why does gross motor development" }).first();
ok((await motor.count()) === 1, "the head-control round is on the page");
await motor.scrollIntoViewIfNeeded();
await until(async () => (await motor.locator("img").count()) > 0, 60000).catch(() => {}); // the list of pictures is one request, slow on a dev server's first compile
ok((await motor.locator("img").count()) > 0, `the learner's own pictures appear under the sections that cite them (${await motor.locator("img").count()})`);
ok((await motor.getByText(/Original image/).count()) > 0, "each picture is labelled as the original");
ok((await motor.getByText("AI-generated, not clinically reviewed").count()) === 1, "the badge does not claim the round is all from the notes");
for (const [name, w, h] of [["desktop", 1440, 900], ["tablet", 820, 1180], ["phone", 390, 844]] as const) {
  await page.setViewportSize({ width: w, height: h });
  await page.waitForTimeout(1200);
  ok(await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth) <= 1, `${name}: no sideways page scroll`);
  const small = await motor.locator("label:has(input[type=radio]), summary, button").evaluateAll(els => els.filter(e => (e as HTMLElement).offsetParent !== null).map(e => ({ h: Math.round(e.getBoundingClientRect().height), t: (e as HTMLElement).innerText.slice(0, 24) })).sort((a, b) => a.h - b.h).slice(0, 2));
  say(`NOTE ${name}: smallest controls ${JSON.stringify(small)}`);
  await motor.screenshot({ path: join(OUT, `shots/10-head-control-${name}.png`) });
}
await page.setViewportSize({ width: 1440, height: 900 });
// The answer options, with no model call: arrow keys only move the choice; the button opens the check; another choice keeps the reasons; a choice with no reason cannot be sent.
const withOptions = rounds.locator('[role="radiogroup"]').first();
if (await withOptions.count()) {
  const list = withOptions.locator("input[type=radio]");
  await list.first().focus();
  await page.keyboard.press("Space");
  await page.keyboard.press("ArrowDown");
  await page.waitForTimeout(400);
  ok((await page.locator("#check-answer").count()) === 0, "arrow keys compare the options without opening the check");
  const card = page.locator('[data-testid="go-deeper-round"] li', { has: page.locator('[role="radiogroup"]') }).first();
  await card.getByRole("button", { name: "Answer with this choice" }).click();
  await page.waitForTimeout(500);
  const box = page.locator("#check-answer");
  ok((await box.inputValue()).startsWith("I chose:"), "the button opens the check with the choice written in");
  ok(await card.getByRole("button", { name: /Check my answer/i }).isDisabled(), "a choice with no reason cannot be sent");
  await box.fill(`${await box.inputValue()}my reasons here`);
  await list.first().check();
  await card.getByRole("button", { name: "Answer with this choice" }).click();
  await page.waitForTimeout(400);
  ok((await box.inputValue()).endsWith("my reasons here"), "another choice keeps the reasons written");
  await card.screenshot({ path: join(OUT, "shots/11-answer-options.png") });
  await card.getByRole("button", { name: /^Skip/ }).click().catch(() => {});
} else say("NOTE no round on the page has options");
const { data: kept, error } = await admin.from("individual_scholar_attempt").select("marking, score, correct, answered_at").eq("user_id", userId).eq("marking", "ai_evaluation").order("answered_at", { ascending: false }).limit(1);
ok(!error && !!kept?.[0], `the judged check from the walk is kept through the existing mechanism (marking ${kept?.[0]?.marking}, score ${kept?.[0]?.score}, at ${kept?.[0]?.answered_at})`);
await setPolicy("off");
await new Promise(r => setTimeout(r, 2500));
const { data: ai, error: e2 } = await admin.from("plat_ai_requests").select("id").eq("actor_id", userId).gte("created_at", since);
if (e2) throw new Error(e2.message);
ok((ai ?? []).length === 0, `this pass made no model call (${(ai ?? []).length})`);
say("NOTE staging policy left OFF");
appendFileSync(join(OUT, "walk-result.txt"), `\n--- second pass (read-only) ---\n${lines.join("\n")}\n`);
await b.close();
