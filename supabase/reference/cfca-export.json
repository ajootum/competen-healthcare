{"cpus": [{"id": "061140fb-e855-4ec9-8ce6-bc226a98e982", "code": "CPU-DIS-010", "name": "Gait, Balance and Mobility Assessment", "complexity": 3, "pub_status": "draft", "sort_order": 0, "description": "Assessment of gait, balance and mobility is the culmination of the neurological examination. While previous Clinical Practice Units have examined individual components of neurological function—including mental status, cranial nerves, motor function, sensation, reflexes and cerebellar coordination—gait assessment evaluates how these systems integrate to produce purposeful, safe and efficient movement. Walking is one of the most complex motor activities performed by humans and requires the coordinated interaction of the cerebral cortex, basal ganglia, cerebellum, brainstem, spinal cord, peripheral nerves, musculoskeletal system and sensory pathways. Gait is often described as a \"functional neurological examination.\" Careful observation of a patient walking can reveal subtle abnormalities that may not be apparent during examination in the seated or supine position. Changes in posture, arm swing, stride length, cadence, balance, turning and initiation of movement frequently provide important clues regarding the location and nature of neurological disease. Experienced clinicians often develop a differential diagnosis within seconds of observing a patient's gait. Normal locomotion depend\n\nAssessment of gait, balance and mobility is a core component of neurological examination and functional assessment. It enables clinicians to evaluate the integrated performance of the nervous, musculoskeletal and vestibular systems during movement, identify neurological and functional impairment, assess falls risk and determine the patient's level of independence. Because walking requires the coordinated activity of multiple body systems, abnormalities in gait often provide valuable diagnostic information and may be among the earliest manifestations of neurological disease. This Clinical Practice Unit defines the scope of practice for healthcare professionals performing gait and balance assessment across a range of clinical environments. It outlines the competencies required to conduct saf", "practice_id": "76f641ae-f758-49ec-a805-fff61237311f", "version_num": 0, "risk_category": "standard", "reassessment_months": 12}, {"id": "3aeccab9-dcb5-4c8f-a61d-f9480097205e", "code": "CPU-OXYSAFE-001", "name": "Safe Oxygen Administration", "complexity": 2, "pub_status": "published", "sort_order": 1, "description": "Assess oxygen requirement, select and apply delivery devices, titrate flow, monitor saturation, escalate deterioration and document therapy.", "practice_id": "fe3e895c-4139-4047-9ff4-2a495ba0d38b", "version_num": 0, "risk_category": "high", "reassessment_months": 12}], "format": "competen-cfca-export-v1", "domains": [{"id": "3641d07b-e822-4331-929d-d7d0ac06aa60", "name": "Domain 1: Assessment", "sort_order": 1, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "425c0784-1193-4d7c-8756-90550256fc21", "name": "Domain 2: Airway", "sort_order": 2, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "6139d6b9-52ce-4608-8031-58a89d51ddea", "name": "Domain 3: Breathing", "sort_order": 3, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "44855954-85a2-45af-b779-1f8abb91fdf1", "name": "Domain 4: Circulation", "sort_order": 4, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "2ab2ceb0-7641-4922-a9ae-ba6da50ecdf1", "name": "Domain 5: Disability (Neuro)", "sort_order": 5, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "b81da076-aa9e-4a98-a3ac-e0f5e8a79b30", "name": "Domain 6: Exposure / Skin / Wound Care", "sort_order": 6, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "0eb24723-c2a5-4601-bf9d-2f14b16e1f67", "name": "Domain 7: Renal", "sort_order": 7, "framework_id": "29c62054-8dff-42a5-baaa-e69b96ca85d7"}, {"id": "7d0554c4-8f06-4d16-8213-6473f97d5481", "name": "Domain 